{
  "name": "journey-visualiser-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:fix": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "knip": "knip",
    "check-all": "npm run lint && npm run type-check && npm run format && npm run knip",
    "fix-all": "npm run lint:fix && npm run format:fix && npm run knip"
  },
  "dependencies": {
    "@expo-google-fonts/nunito": "^0.4.2",
    "@turf/helpers": "^7.2.0",
    "@turf/nearest-point-on-line": "^7.2.0",
    "expo": "~54.0.22",
    "expo-dev-client": "~6.0.16",
    "expo-font": "~14.0.9",
    "expo-location": "^19.0.7",
    "expo-status-bar": "~3.0.8",
    "lucide-react-native": "^0.552.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-svg": "15.12.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "~19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-native": "^5.0.0",
    "globals": "^16.5.0",
    "knip": "^5.67.1",
    "prettier": "^3.6.2",
    "typescript": "~5.9.2"
  },
  "private": true
}
